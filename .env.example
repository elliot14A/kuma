# ------------------------------------------------------------------------------
# Kuma Environment Configuration
# All application variables strictly adhere to the KUMA_{SETTING} format.
# ------------------------------------------------------------------------------

# Server & Runtime
KUMA_PORT=8080
KUMA_HOST=0.0.0.0
KUMA_ENV=development
KUMA_SERVER_PORT=8080
KUMA_SERVER_HOST=0.0.0.0

# Database Configuration (PostgreSQL URL only)
KUMA_DATABASE_URL=postgres://kuma:kuma_dev_password@localhost:5432/kuma

# Nebius TokenFactory & Sandboxes
KUMA_NEBIUS_API_KEY=
KUMA_NEBIUS_BASE_URL=https://api.tokenfactory.nebius.com/v1
KUMA_NEBIUS_MODEL=nvidia/Llama-3.1-Nemotron-70B-Instruct

KUMA_SANDBOX_API_KEY=
KUMA_SANDBOX_ENDPOINT=https://sandboxes.tokenfactory.nebius.com/v1

KUMA_TAVILY_API_KEY=
